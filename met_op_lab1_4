import numpy as np
import matplotlib.pyplot as plt
import scipy.stats as stats

# Данные из таблицы
data = np.array([
    4.73, 2.06, 3.13, 3.81, 3.30, 4.21, 8.07, 6.25,
    4.88, 5.25, 4.08, 6.22, 4.53, 5.33, 4.85, 4.21,
    3.85, 4.76, 4.96, 5.89, 4.76, 2.17, 3.84, 5.37,
    4.73, 3.28, 8.60, 6.13, 6.04, 5.15, 5.02, 4.43,
    4.29, 3.32, 6.30, 6.84, 6.75, 3.68, 3.49, 4.73
])

# Оценка параметров распределения Лапласа (среднее и b)
mu = np.mean(data)
b = np.mean(np.abs(data - mu))  # Оценка параметра b

# Теоретическая плотность распределения Лапласа
x = np.linspace(min(data), max(data), 1000)
laplace_pdf = stats.laplace.pdf(x, loc=mu, scale=b)

# Границы интервалов
bins = [2.06, 3.09, 4.13, 5.16, 6.20, 7.23, 8.27, 9.30]

# Гистограммы с 7 интервалами
plt.figure(figsize=(8, 5))
plt.hist(data, bins=bins, density=True, alpha=0.6, color='b', edgecolor='black', label="Гистограмма выборки")

# Теоретическая плотность распределения Лапласа
plt.plot(x, laplace_pdf, 'r-', label="Теоретическая плотность Лапласа")

# Оформление графика
plt.xlabel("Значение")
plt.ylabel("Плотность вероятности")
plt.title("Гистограмма с диапазонами и распределение Лапласа")
plt.legend()
plt.grid()

# Показать график
plt.show()

# Оценка параметров распределения Лапласа
mu = np.mean(data)
b = np.mean(np.abs(data - mu))

# Критерий Колмогорова-Смирнова
ks_statistic, p_value = stats.kstest(data, 'laplace', args=(mu, b))

print(f"Статистика критерия Колмогорова-Смирнова: {ks_statistic}")
print(f"P-value: {p_value}")

if p_value > 0.05:
    print("Нет оснований отвергать гипотезу о соответствии распределению Лапласа.")
else:
    print("Гипотеза о распределении Лапласа отвергается.")
